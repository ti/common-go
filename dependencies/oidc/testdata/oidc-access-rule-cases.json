{
  "description": "Claim access rules from the auth URI query. Every query parameter other than scope and oidc_logout is a rule: the named claim must contain at least one listed value (OR); all rules must match (AND). Values split on spaces (%20 or +) and commas, in both the URI and string claims. Dotted names match an exact top-level claim first, then nested objects. No claim name is special or aliased (groups does not read group). Claims are raw JSON text so integer precision is preserved. Denials are 403, after token validation (401).",
  "parse_cases": [
    {
      "name": "skips_provider_options",
      "query": "scope=offline%20openid&oidc_logout=false&groups=labs%20admin",
      "rules": [
        {
          "path": "groups",
          "values": [
            "labs",
            "admin"
          ]
        }
      ]
    },
    {
      "name": "multi_claim_example",
      "query": "scope=offline%20all%20openid&groups=labs%20admin&sub=23321312321&email=i%40example.com%20test%40gmail.com&data.email=i%40example.com%20test%40gmail.com",
      "rules": [
        {
          "path": "data.email",
          "values": [
            "i@example.com",
            "test@gmail.com"
          ]
        },
        {
          "path": "email",
          "values": [
            "i@example.com",
            "test@gmail.com"
          ]
        },
        {
          "path": "groups",
          "values": [
            "labs",
            "admin"
          ]
        },
        {
          "path": "sub",
          "values": [
            "23321312321"
          ]
        }
      ]
    },
    {
      "name": "sorted_and_merged",
      "query": "user.role=a,b&groups=x&user.role=c+a",
      "rules": [
        {
          "path": "groups",
          "values": [
            "x"
          ]
        },
        {
          "path": "user.role",
          "values": [
            "a",
            "b",
            "c"
          ]
        }
      ]
    },
    {
      "name": "no_rules",
      "query": "scope=openid",
      "rules": []
    },
    {
      "name": "empty_value_fails",
      "query": "scope=openid&groups=",
      "error": true
    },
    {
      "name": "separator_only_fails",
      "query": "groups=%20,",
      "error": true
    },
    {
      "name": "empty_name_fails",
      "query": "=labs",
      "error": true
    }
  ],
  "allow_cases": [
    {
      "name": "no_rules_allows_any_valid_token",
      "query": "scope=openid%20profile",
      "claims": "{}",
      "allow": true
    },
    {
      "name": "groups_string",
      "query": "groups=labs%20admin",
      "claims": "{\"groups\":\"labs\"}",
      "allow": true
    },
    {
      "name": "groups_space_string",
      "query": "groups=labs%20admin",
      "claims": "{\"groups\":\"users admin\"}",
      "allow": true
    },
    {
      "name": "groups_comma_string",
      "query": "groups=labs%20admin",
      "claims": "{\"groups\":\"users,admin\"}",
      "allow": true
    },
    {
      "name": "groups_array",
      "query": "groups=labs%20admin",
      "claims": "{\"groups\":[\"users\",\"admin\"]}",
      "allow": true
    },
    {
      "name": "groups_miss",
      "query": "groups=labs%20admin",
      "claims": "{\"groups\":[\"test\"]}",
      "allow": false
    },
    {
      "name": "groups_claim_missing",
      "query": "groups=labs%20admin",
      "claims": "{\"sub\":\"u1\"}",
      "allow": false
    },
    {
      "name": "exact_match_only",
      "query": "groups=lab",
      "claims": "{\"groups\":\"labs\"}",
      "allow": false
    },
    {
      "name": "case_sensitive",
      "query": "groups=admin",
      "claims": "{\"groups\":\"Admin\"}",
      "allow": false
    },
    {
      "name": "nested_string",
      "query": "user.role=labs%20admin",
      "claims": "{\"user\":{\"role\":\"admin\"}}",
      "allow": true
    },
    {
      "name": "nested_array",
      "query": "user.role=labs%20admin",
      "claims": "{\"user\":{\"role\":[\"admin\"]}}",
      "allow": true
    },
    {
      "name": "nested_miss",
      "query": "user.role=labs%20admin",
      "claims": "{\"user\":{\"role\":[\"guest\"]}}",
      "allow": false
    },
    {
      "name": "flat_dotted_key_wins",
      "query": "user.role=admin",
      "claims": "{\"user.role\":\"admin\",\"user\":{\"role\":\"guest\"}}",
      "allow": true
    },
    {
      "name": "path_through_non_object",
      "query": "user.role=admin",
      "claims": "{\"user\":\"admin\"}",
      "allow": false
    },
    {
      "name": "no_alias_for_other_claims",
      "query": "user.role=admin",
      "claims": "{\"user\":{\"roles\":[\"admin\"]}}",
      "allow": false
    },
    {
      "name": "all_rules_must_match",
      "query": "user.role=labs%20admin&sub=uid1234%20uid456&flag=office%20school",
      "claims": "{\"sub\":\"uid456\",\"user\":{\"role\":[\"labs\"]},\"flag\":\"school\"}",
      "allow": true
    },
    {
      "name": "one_rule_fails",
      "query": "user.role=labs%20admin&sub=uid1234%20uid456&flag=office%20school",
      "claims": "{\"sub\":\"uid999\",\"user\":{\"role\":[\"labs\"]},\"flag\":\"school\"}",
      "allow": false
    },
    {
      "name": "plus_is_space",
      "query": "groups=labs+admin",
      "claims": "{\"groups\":[\"admin\"]}",
      "allow": true
    },
    {
      "name": "repeated_param_adds_values",
      "query": "groups=labs&groups=admin",
      "claims": "{\"groups\":[\"admin\"]}",
      "allow": true
    },
    {
      "name": "singular_claim_not_aliased",
      "query": "groups=admin",
      "claims": "{\"group\":\"admin\"}",
      "allow": false
    },
    {
      "name": "plural_claim_not_aliased",
      "query": "group=admin",
      "claims": "{\"groups\":[\"admin\"]}",
      "allow": false
    },
    {
      "name": "nested_groups_no_alias",
      "query": "org.groups=labs",
      "claims": "{\"org\":{\"group\":[\"labs\"]}}",
      "allow": false
    },
    {
      "name": "encoded_email_value",
      "query": "email=i%40example.com%20test%40gmail.com",
      "claims": "{\"email\":\"test@gmail.com\"}",
      "allow": true
    },
    {
      "name": "multi_claim_all_match",
      "query": "scope=offline%20all%20openid&groups=labs%20admin&sub=23321312321&email=i%40example.com%20test%40gmail.com&data.email=i%40example.com%20test%40gmail.com",
      "claims": "{\"sub\":\"23321312321\",\"groups\":[\"admin\",\"dev\"],\"email\":\"i@example.com\",\"data\":{\"email\":\"test@gmail.com\"}}",
      "allow": true
    },
    {
      "name": "multi_claim_array_values",
      "query": "scope=offline%20all%20openid&groups=labs%20admin&sub=23321312321&email=i%40example.com%20test%40gmail.com&data.email=i%40example.com%20test%40gmail.com",
      "claims": "{\"sub\":\"23321312321\",\"groups\":\"labs\",\"email\":[\"x@y.z\",\"test@gmail.com\"],\"data\":{\"email\":[\"i@example.com\"]}}",
      "allow": true
    },
    {
      "name": "multi_claim_numeric_sub",
      "query": "scope=offline%20all%20openid&groups=labs%20admin&sub=23321312321&email=i%40example.com%20test%40gmail.com&data.email=i%40example.com%20test%40gmail.com",
      "claims": "{\"sub\":23321312321,\"groups\":[\"labs\"],\"email\":\"i@example.com\",\"data\":{\"email\":\"i@example.com\"}}",
      "allow": true
    },
    {
      "name": "multi_claim_nested_missing",
      "query": "scope=offline%20all%20openid&groups=labs%20admin&sub=23321312321&email=i%40example.com%20test%40gmail.com&data.email=i%40example.com%20test%40gmail.com",
      "claims": "{\"sub\":\"23321312321\",\"groups\":[\"admin\"],\"email\":\"i@example.com\"}",
      "allow": false
    },
    {
      "name": "multi_claim_email_miss",
      "query": "scope=offline%20all%20openid&groups=labs%20admin&sub=23321312321&email=i%40example.com%20test%40gmail.com&data.email=i%40example.com%20test%40gmail.com",
      "claims": "{\"sub\":\"23321312321\",\"groups\":[\"admin\"],\"email\":\"other@example.com\",\"data\":{\"email\":\"i@example.com\"}}",
      "allow": false
    },
    {
      "name": "multi_claim_groups_miss",
      "query": "scope=offline%20all%20openid&groups=labs%20admin&sub=23321312321&email=i%40example.com%20test%40gmail.com&data.email=i%40example.com%20test%40gmail.com",
      "claims": "{\"sub\":\"23321312321\",\"groups\":[\"dev\"],\"email\":\"i@example.com\",\"data\":{\"email\":\"i@example.com\"}}",
      "allow": false
    },
    {
      "name": "number_claim",
      "query": "level=3",
      "claims": "{\"level\":3}",
      "allow": true
    },
    {
      "name": "big_integer_claim",
      "query": "uid=12345678901234567890",
      "claims": "{\"uid\":12345678901234567890}",
      "allow": true
    },
    {
      "name": "bool_claim",
      "query": "email_verified=true",
      "claims": "{\"email_verified\":true}",
      "allow": true
    },
    {
      "name": "oidc_logout_is_not_a_rule",
      "query": "oidc_logout=false",
      "claims": "{}",
      "allow": true
    }
  ]
}
