{
  "swagger": "2.0",
  "info": {
    "title": "example/report/v1/report.proto",
    "version": "version not set"
  },
  "tags": [
    {
      "name": "ReportService",
      "description": "ReportService shows background work with observable status: StartReport\nreturns at once with a job that runs in the server process (package\nbackground), WatchReport streams its state and progress until it is done."
    },
    {
      "name": "UserService",
      "description": "UserService is served by one implementation over native gRPC, REST\n(grpc-gateway, from the google.api.http annotations) and ConnectRPC."
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/v1/reports": {
      "post": {
        "summary": "Starts building a report and returns immediately. Calling it again with\nthe same request_id returns the report that request started.",
        "description": "Errors: RESOURCE_EXHAUSTED when too many reports are waiting,\nUNAVAILABLE while the server is shutting down (retry).",
        "operationId": "ReportService_StartReport",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1StartReportResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1StartReportRequest"
            }
          }
        ],
        "tags": [
          "ReportService"
        ]
      }
    },
    "/v1/reports/{report_id}": {
      "get": {
        "summary": "Gets the current state of a report. NOT_FOUND once it has expired.",
        "operationId": "ReportService_GetReport",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1GetReportResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "report_id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "ReportService"
        ]
      }
    },
    "/v1/reports/{report_id}:cancel": {
      "post": {
        "summary": "Asks a report to stop. A queued report is cancelled at once; a running\none becomes CANCELLED shortly after. Cancelling a report that is done\nchanges nothing.",
        "operationId": "ReportService_CancelReport",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1CancelReportResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "report_id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/ReportServiceCancelReportBody"
            }
          }
        ],
        "tags": [
          "ReportService"
        ]
      }
    },
    "/v1/reports/{report_id}:watch": {
      "get": {
        "summary": "Streams the report's state: the current state first, then every change,\nending after a state that is done (SUCCEEDED, FAILED, CANCELLED,\nINTERRUPTED). The stream ends with UNAVAILABLE when the server starts\nshutting down; call it again to continue.",
        "operationId": "ReportService_WatchReport",
        "responses": {
          "200": {
            "description": "A successful response.(streaming responses)",
            "schema": {
              "type": "object",
              "properties": {
                "result": {
                  "$ref": "#/definitions/v1WatchReportResponse"
                },
                "error": {
                  "$ref": "#/definitions/rpcStatus"
                }
              },
              "title": "Stream result of v1WatchReportResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "report_id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "ReportService"
        ]
      }
    },
    "/v1/users": {
      "get": {
        "summary": "Lists users, newest first, with cursor pagination.",
        "operationId": "UserService_ListUsers",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ListUsersResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "page_size",
            "description": "At most 100; 0 means the default of 20.",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "page_token",
            "description": "next_page_token of the previous response.",
            "in": "query",
            "required": false,
            "type": "string"
          }
        ],
        "tags": [
          "UserService"
        ]
      },
      "post": {
        "summary": "Creates a user. Fails with ALREADY_EXISTS (reason EMAIL_ALREADY_IN_USE)\nif the email is taken.",
        "operationId": "UserService_CreateUser",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1CreateUserResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "user",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1User"
            }
          }
        ],
        "tags": [
          "UserService"
        ]
      }
    },
    "/v1/users/{user.user_id}": {
      "patch": {
        "summary": "Updates the fields named in update_mask (all mutable fields when empty).",
        "operationId": "UserService_UpdateUser",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1UpdateUserResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "user.user_id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "user",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "Field rules skip empty values so partial updates validate; creation\nrequires name and email through the CreateUserRequest rule below."
                },
                "email": {
                  "type": "string"
                },
                "age": {
                  "type": "integer",
                  "format": "int32",
                  "description": "Unset means unknown (proto3 optional, no wrapper types needed)."
                },
                "create_time": {
                  "type": "string",
                  "format": "date-time",
                  "readOnly": true
                },
                "update_time": {
                  "type": "string",
                  "format": "date-time",
                  "readOnly": true
                }
              },
              "required": [
                "name",
                "email"
              ]
            }
          }
        ],
        "tags": [
          "UserService"
        ]
      }
    },
    "/v1/users/{user_id}": {
      "get": {
        "summary": "Gets a user by ID.",
        "operationId": "UserService_GetUser",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1GetUserResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "user_id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "UserService"
        ]
      },
      "delete": {
        "summary": "Deletes a user.",
        "operationId": "UserService_DeleteUser",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1DeleteUserResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "user_id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "UserService"
        ]
      }
    },
    "/v1/users:export": {
      "get": {
        "summary": "Streams every user (server streaming). Served on gRPC, on REST as\nnewline-delimited JSON, and on Connect through a connect-go handler.",
        "operationId": "UserService_ExportUsers",
        "responses": {
          "200": {
            "description": "A successful response.(streaming responses)",
            "schema": {
              "type": "object",
              "properties": {
                "result": {
                  "$ref": "#/definitions/v1ExportUsersResponse"
                },
                "error": {
                  "$ref": "#/definitions/rpcStatus"
                }
              },
              "title": "Stream result of v1ExportUsersResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "tags": [
          "UserService"
        ]
      }
    }
  },
  "definitions": {
    "ReportServiceCancelReportBody": {
      "type": "object"
    },
    "protobufAny": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "rpcStatus": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/protobufAny"
          }
        }
      }
    },
    "v1CancelReportResponse": {
      "type": "object",
      "properties": {
        "report": {
          "$ref": "#/definitions/v1Report"
        }
      }
    },
    "v1CreateUserResponse": {
      "type": "object",
      "properties": {
        "user": {
          "$ref": "#/definitions/v1User"
        }
      }
    },
    "v1DeleteUserResponse": {
      "type": "object"
    },
    "v1ExportUsersResponse": {
      "type": "object",
      "properties": {
        "user": {
          "$ref": "#/definitions/v1User"
        }
      }
    },
    "v1GetReportResponse": {
      "type": "object",
      "properties": {
        "report": {
          "$ref": "#/definitions/v1Report"
        }
      }
    },
    "v1GetUserResponse": {
      "type": "object",
      "properties": {
        "user": {
          "$ref": "#/definitions/v1User"
        }
      }
    },
    "v1ListUsersResponse": {
      "type": "object",
      "properties": {
        "users": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1User"
          }
        },
        "next_page_token": {
          "type": "string",
          "description": "Empty when there are no more pages."
        }
      }
    },
    "v1Report": {
      "type": "object",
      "properties": {
        "report_id": {
          "type": "string",
          "readOnly": true
        },
        "state": {
          "$ref": "#/definitions/v1State",
          "readOnly": true
        },
        "done_sections": {
          "type": "integer",
          "format": "int32",
          "description": "Progress in sections; total_sections is what was requested.",
          "readOnly": true
        },
        "total_sections": {
          "type": "integer",
          "format": "int32",
          "readOnly": true
        },
        "error": {
          "type": "string",
          "description": "Why the report failed, was cancelled or was interrupted.",
          "readOnly": true
        },
        "summary": {
          "type": "string",
          "description": "The finished report, set when state is SUCCEEDED.",
          "readOnly": true
        },
        "create_time": {
          "type": "string",
          "format": "date-time",
          "readOnly": true
        },
        "finish_time": {
          "type": "string",
          "format": "date-time",
          "readOnly": true
        }
      }
    },
    "v1StartReportRequest": {
      "type": "object",
      "properties": {
        "sections": {
          "type": "integer",
          "format": "int32",
          "description": "Number of sections to build (the example's unit of work)."
        },
        "section_millis": {
          "type": "integer",
          "format": "int32",
          "description": "Time spent on each section, in milliseconds (simulated work)."
        },
        "request_id": {
          "type": "string",
          "description": "Optional client-generated ID that makes the call idempotent."
        }
      }
    },
    "v1StartReportResponse": {
      "type": "object",
      "properties": {
        "report": {
          "$ref": "#/definitions/v1Report"
        }
      }
    },
    "v1State": {
      "type": "string",
      "enum": [
        "STATE_UNSPECIFIED",
        "STATE_QUEUED",
        "STATE_RUNNING",
        "STATE_SUCCEEDED",
        "STATE_FAILED",
        "STATE_CANCELLED",
        "STATE_INTERRUPTED"
      ],
      "default": "STATE_UNSPECIFIED",
      "description": "State of a report.\n\n - STATE_QUEUED: Accepted, waiting for a worker (or for a retry).\n - STATE_CANCELLED: Stopped by CancelReport.\n - STATE_INTERRUPTED: Stopped because the server shut down before the report was finished."
    },
    "v1UpdateUserResponse": {
      "type": "object",
      "properties": {
        "user": {
          "$ref": "#/definitions/v1User"
        }
      }
    },
    "v1User": {
      "type": "object",
      "properties": {
        "user_id": {
          "type": "string",
          "readOnly": true
        },
        "name": {
          "type": "string",
          "description": "Field rules skip empty values so partial updates validate; creation\nrequires name and email through the CreateUserRequest rule below."
        },
        "email": {
          "type": "string"
        },
        "age": {
          "type": "integer",
          "format": "int32",
          "description": "Unset means unknown (proto3 optional, no wrapper types needed)."
        },
        "create_time": {
          "type": "string",
          "format": "date-time",
          "readOnly": true
        },
        "update_time": {
          "type": "string",
          "format": "date-time",
          "readOnly": true
        }
      },
      "required": [
        "name",
        "email"
      ]
    },
    "v1WatchReportResponse": {
      "type": "object",
      "properties": {
        "report": {
          "$ref": "#/definitions/v1Report"
        }
      }
    }
  }
}
